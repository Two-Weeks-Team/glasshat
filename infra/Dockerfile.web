# Glasshat web (Next.js) — multi-stage. Build context = apps/web.
#   docker build -f infra/Dockerfile.web -t glasshat-web apps/web
FROM node:22-slim AS builder
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . ./
RUN pnpm build

FROM node:22-slim AS runtime
WORKDIR /app
RUN corepack enable && useradd --create-home --uid 10001 app
COPY --from=builder /app /app
ENV NODE_ENV=production \
    PORT=3000
USER app
EXPOSE 3000
CMD ["sh", "-c", "pnpm start -p ${PORT:-3000}"]
