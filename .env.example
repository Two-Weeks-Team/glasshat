# Glasshat (Panelyst) — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# AI provider policy: Gemini / Google Cloud ONLY. No OpenAI/Anthropic in production.
# Vector store policy: NO Qdrant — Vertex embeddings + in-code hybrid retrieval
#   (dense cosine + rank-bm25 sparse + RRF) over Firestore + in-memory index.
# Orchestrator: Google ADK. Track: Arize (dual-rubric variance is a feature).
# Bootstrap recipe: docs/gcp-setup.md.

# === Identity / GCP project ===
GOOGLE_CLOUD_PROJECT=                       # e.g. panelyst-hackathon
GOOGLE_CLOUD_REGION=us-central1             # Cloud Run + regional embeddings (Gemini 3.x uses `global`, set per-tier below)
GOOGLE_GENAI_USE_VERTEXAI=true              # always — Vertex (IAM/ADC), not AI Studio

# === Service account credentials (kept OUTSIDE the repo) ===
GOOGLE_APPLICATION_CREDENTIALS=             # absolute path to the SA JSON key
GLASSHAT_SA_EMAIL=                          # e.g. panelyst-dev@panelyst-hackathon.iam.gserviceaccount.com

# === Gemini models (3-tier) ===
# Gemini 3 family is served on the `global` endpoint ONLY (regional returns 404).
GLASSHAT_GEMINI_PRO=gemini-3.1-pro-preview
GLASSHAT_GEMINI_PRO_LOCATION=global
GLASSHAT_GEMINI_FLASH=gemini-3-flash-preview
GLASSHAT_GEMINI_FLASH_LOCATION=global
GLASSHAT_GEMINI_FLASH_LITE=gemini-3.1-flash-lite
GLASSHAT_GEMINI_FLASH_LITE_LOCATION=global

# === Backend selectors (config flip — see docs/architecture.md §5) ===
LLM_BACKEND=mock                            # mock | vertex   (mock = deterministic, no creds, for tests/CI)
MONITOR_BACKEND=phoenix-local               # phoenix-local | phoenix-cloud | arize   (live deploy uses `arize`)
DOCSTORE_BACKEND=memory                     # memory | sqlite | firestore
BLOB_BACKEND=local-fs                       # local-fs | gcs
AGENT_RUNTIME=adk-local                     # adk-local | adk-cloud-run

# === Monitoring (Arize AX / Phoenix — OTLP) ===
# Live deploy uses MONITOR_BACKEND=arize → Arize AX (otlp.arize.com), which needs
# PHOENIX_API_KEY (the AX `ak-…` key) + ARIZE_SPACE_ID below.
# Local dev: in-process Phoenix (phoenix-local) or Phoenix Cloud (phoenix-cloud).
PHOENIX_API_KEY=                            # Arize AX `ak-…` key when MONITOR_BACKEND=arize
PHOENIX_COLLECTOR_ENDPOINT=                 # phoenix-cloud only (e.g. https://app.phoenix.arize.com)
PHOENIX_PROJECT_NAME=glasshat
ARIZE_SPACE_ID=                             # required when MONITOR_BACKEND=arize (app.arize.com → Space → API Keys)

# === DocStore ===
DOCSTORE_SQLITE_PATH=./var/glasshat.db
FIRESTORE_PROJECT_ID=

# === BlobStore ===
BLOB_LOCAL_DIR=./var/uploads
GCS_UPLOADS_BUCKET=
GCS_REPORTS_BUCKET=

# === Repo ingestion ===
GITHUB_TOKEN=

# === App ===
PORT=8080
NEXT_PUBLIC_DEFAULT_LOCALE=en               # en | ko
